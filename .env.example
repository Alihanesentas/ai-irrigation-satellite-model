# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Storage ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000

# --- Sentinel-2 / Sentinel-1 access (Copernicus Data Space Ecosystem) ---
# Register at https://dataspace.copernicus.eu
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- SMAP soil moisture, primary source (NASA Earthdata) ---
# Register at https://urs.earthdata.nasa.gov
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# --- ISMN soil moisture, cross-validation pipeline ---
# Register at https://ismn.earth
ISMN_USERNAME=
ISMN_PASSWORD=

# --- ERA5-Land archive weather (training path only — never operational, see weather-forcing-split.md) ---
# Register at https://cds.climate.copernicus.eu
COPERNICUS_CDS_API_KEY=

# --- Landsat-8/9, historical calibration reference (see decisions/landsat-data-access.md) ---
# Primary: Microsoft Planetary Computer STAC API — no key required for read access.
# Fallback: USGS M2M. Register at https://m2m.cr.usgs.gov
USGS_M2M_USERNAME=
USGS_M2M_TOKEN=

# --- Open-Meteo, operational weather ---
# Free tier requires no API key — https://open-meteo.com
